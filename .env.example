TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY_URL=
STH_WEBHOOK_TOKEN=replace-with-a-random-secret
HOME_ASSISTANT_TOKEN=
POSTGRES_DB=server_tg_home
POSTGRES_USER=server_tg_home
POSTGRES_PASSWORD=replace-with-a-random-password

# Keep loopback when the reverse proxy is on the same host. For Caddy on a
# separate trusted host, set the mini PC LAN/VPN address and restrict these
# trusted upstream ports (18082, 28080, 21984) with the host firewall.
STH_REVERSE_PROXY_BIND_ADDRESS=127.0.0.1
COMPOSE_PROFILES=miniapp
