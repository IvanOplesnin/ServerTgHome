{
	admin off
}

{$STH_PUBLIC_HOST:localhost} {
	encode zstd gzip

	header {
		-Server
		Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' wss://{$STH_PUBLIC_HOST:localhost}; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors https://telegram.org https://*.telegram.org"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}

	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@webapp_api path /api/webapp /api/webapp/*
	handle @webapp_api {
		reverse_proxy api:8080
	}

	@blocked_api path /api /api/*
	handle @blocked_api {
		respond "Not Found" 404
	}

	@player_scripts path /media/video-stream.js /media/video-rtc.js
	handle @player_scripts {
		uri strip_prefix /media
		header Cache-Control "public, max-age=86400"
		reverse_proxy go2rtc:1984
	}

	@protected_media {
		method GET HEAD
		path_regexp protected_media ^/media/t/[A-Za-z0-9_-]{32,256}(?P<upstream>/api/(?:ws|stream[.]m3u8|hls/(?:playlist[.]m3u8|segment[.]ts|init[.]mp4|segment[.]m4s)))$
	}
	handle @protected_media {
		route {
			forward_auth api:8080 {
				uri /api/webapp/v1/media/authorize
			}
			rewrite * {re.protected_media.upstream}
			header Cache-Control "no-store"
			reverse_proxy go2rtc:1984 {
				# Re-authorize persistent WebSocket media connections regularly.
				# The frontend reconnects before this limit during normal viewing.
				stream_timeout 10m
			}
		}
	}

	@blocked_media path /media /media/*
	handle @blocked_media {
		respond "Not Found" 404
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
